rules_version = '2';

// Curated Kitchen access model
// ----------------------------
// A household is the unit of trust. Members (you + partner) read and write
// everything the household owns. Friends get read-only access to recipes the
// household has explicitly marked 'friends' — never to grocery lists.
//
// Joining a household is by invite code (see the `invites` collection and the
// join branches on `households` below). A code is an unguessable secret: the
// invite document is readable by anyone signed in, because knowing the code is
// the authorization. Redeeming it can only ever add the caller — and no one
// else — to the household it names, and only while the invite exists.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function householdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function householdExists(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId));
    }

    function isMember(householdId) {
      return isSignedIn()
        && householdId is string
        && householdExists(householdId)
        && request.auth.uid in householdData(householdId).memberUids;
    }

    function isFriend(householdId) {
      return isSignedIn()
        && householdId is string
        && householdExists(householdId)
        && request.auth.uid in householdData(householdId).friendUids;
    }

    // The owner is the creator. Only they may remove or change the role of a
    // member; they can never be removed or demoted (see the update rule).
    function isOwner(householdId) {
      return isSignedIn()
        && householdId is string
        && householdExists(householdId)
        && request.auth.uid == householdData(householdId).ownerUid;
    }

    // The invite code the caller has staged on their own profile (see the join
    // flow). Binding the code to the caller's user doc is what lets the rule
    // below verify *which* invite is being redeemed — a rule can't see a query
    // filter or a client variable, only documents it get()s.
    function stagedInvite() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('pendingInvite', null)
        : null;
    }

    // True when the caller holds a valid staged invite for this household and
    // role. The invite must exist and name exactly this household and role.
    function redeemingInvite(householdId, role) {
      let code = stagedInvite();
      return code is string
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.householdId == householdId
        && get(/databases/$(database)/documents/invites/$(code)).data.role == role;
    }

    // True when `after` is `before` with exactly the caller's own uid added —
    // nobody else, nothing removed. This is what keeps a redeemed invite from
    // adding arbitrary members.
    function addedOnlySelf(before, after) {
      return after.hasAll(before)
        && after.size() == before.size() + 1
        && (request.auth.uid in after)
        && !(request.auth.uid in before);
    }

    // A join touches only the one membership array and nothing else.
    function onlyChanged(key) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([key]);
    }

    // True when `after` is `before` with exactly the caller's own uid removed —
    // nobody else, nothing added. This is what lets someone leave the kitchen
    // without being able to remove anyone else.
    function removedOnlySelf(before, after) {
      return before.hasAll(after)
        && after.size() == before.size() - 1
        && (request.auth.uid in before)
        && !(request.auth.uid in after);
    }

    function ownerUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    // Neither membership array is touched by this write.
    function membershipUnchanged() {
      return request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.friendUids == resource.data.friendUids;
    }

    // Profiles are readable by any signed-in user so the UI can show who added
    // a recipe or checked off an item. `pendingInvite` is the only writable-by-
    // self field that rules depend on; it names a secret code the caller
    // already holds, so exposing it to a reader gives nothing away.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /households/{householdId} {
      allow read: if isMember(householdId) || isFriend(householdId);

      // A household is created owned by, and containing, exactly its creator.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      // Ways to update a household:
      //  1. A member edits non-membership fields (rename, current invite code).
      //     The two membership arrays are governed by the branches below, so a
      //     member can't quietly remove or add people here.
      //  2. The owner manages membership and roles — remove a member, promote a
      //     friend, demote a member — changing only the two arrays and always
      //     remaining a member. This is what keeps the owner un-removable and
      //     un-demotable, and keeps role changes owner-only.
      //  3. Any member drops a read-only friend (guest): removals only, and
      //     never touching memberUids.
      //  4. A newcomer redeems a member invite, adding only themselves.
      //  5. A newcomer redeems a friend invite, adding only themselves.
      //  6. Anyone but the owner removes only themselves — leaving the kitchen.
      allow update: if
        (isMember(householdId) && ownerUnchanged() && membershipUnchanged())

        || (isOwner(householdId)
          && ownerUnchanged()
          && (resource.data.ownerUid in request.resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'friendUids']))

        || (isMember(householdId)
          && onlyChanged('friendUids')
          && resource.data.friendUids.hasAll(request.resource.data.friendUids))

        || (onlyChanged('memberUids')
          && addedOnlySelf(resource.data.memberUids, request.resource.data.memberUids)
          && redeemingInvite(householdId, 'member'))

        || (onlyChanged('friendUids')
          && addedOnlySelf(resource.data.friendUids, request.resource.data.friendUids)
          && redeemingInvite(householdId, 'friend'))

        || (onlyChanged('memberUids')
          && removedOnlySelf(resource.data.memberUids, request.resource.data.memberUids)
          && request.auth.uid != resource.data.ownerUid)

        || (onlyChanged('friendUids')
          && removedOnlySelf(resource.data.friendUids, request.resource.data.friendUids));

      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Invite codes. The document id IS the code, so it must be long and random.
    // Any signed-in user may read one (knowing the code is the authorization);
    // only a member may mint or revoke invites for their own household.
    match /invites/{code} {
      allow read: if isSignedIn();
      allow create: if isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.role in ['member', 'friend'];
      allow update: if false;
      allow delete: if isSignedIn() && isMember(resource.data.householdId);
    }

    match /recipes/{recipeId} {
      allow read: if isMember(resource.data.householdId)
        || (resource.data.visibility == 'friends' && isFriend(resource.data.householdId));

      allow create: if isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid;

      // A recipe cannot be moved into a household you don't belong to.
      allow update: if isMember(resource.data.householdId)
        && isMember(request.resource.data.householdId);

      allow delete: if isMember(resource.data.householdId);
    }

    // Step photos, stored as compressed data URLs on their own documents (see
    // src/data/photos.ts). Same trust model as the recipes they belong to:
    // members of the photo's household may add or delete them, and members OR
    // read-only guests may read them (guests can see shared recipes, so they can
    // see those recipes' photos). We never update a photo in place — an edit
    // creates a new one — so there's no update rule.
    match /photos/{photoId} {
      allow read: if isMember(resource.data.householdId)
        || isFriend(resource.data.householdId);

      allow create: if isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid;

      allow delete: if isMember(resource.data.householdId);
    }

    // Grocery lists and the cook log are household-only — friends never see
    // what you're buying or what you cooked last Tuesday.
    // The grocery list. Its document id IS the household id by construction, so
    // membership is checked on listId directly — no read of the parent doc,
    // which also means an item subcollection reads fine before the (lazily
    // created) parent list doc exists, instead of erroring on an empty list.
    match /lists/{listId} {
      allow read, write: if isMember(listId);

      match /items/{itemId} {
        allow read, write: if isMember(listId);
      }
    }

    // The shared meal plan. Like the grocery list, its document id IS the
    // household id, so membership is checked on planId directly — the entries
    // subcollection then reads fine before the (lazily created) parent doc
    // exists. Household-only: friends never see what's being cooked this week.
    match /plans/{planId} {
      allow read, write: if isMember(planId);

      match /entries/{entryId} {
        allow read, write: if isMember(planId);
      }
    }

    // The live "cook together" session. One doc per household (id = household
    // id), read/written by both phones as they step through a recipe together.
    // Household-only, same as everything else the household owns.
    match /sessions/{sessionId} {
      allow read, write: if isMember(sessionId);
    }

    match /cooks/{cookId} {
      allow read, update, delete: if isMember(resource.data.householdId);
      allow create: if isMember(request.resource.data.householdId)
        && request.resource.data.cookedBy == request.auth.uid;
    }

    // Anything not matched above is denied. New collections must add rules
    // here before they will work.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
