rules_version = '2';

// Curated Kitchen — Storage access model (step photos).
// ----------------------------------------------------
// Photos live under recipe-photos/<householdId>/... and follow the same trust
// model as recipes: members of the household may add/replace/delete them, and
// members OR read-only guests may view them (guests can see shared recipes, so
// they can see those recipes' photos). Membership is read from the household
// doc in Firestore — the same source of truth firestore.rules uses.
//
// This is a SEPARATE file from firestore.rules and deploys separately:
//   npm run deploy:storage   (or Firebase console → Storage → Rules → Publish)
service firebase.storage {
  match /b/{bucket}/o {

    function household(hid) {
      return firestore.get(/databases/(default)/documents/households/$(hid)).data;
    }
    function householdExists(hid) {
      return firestore.exists(/databases/(default)/documents/households/$(hid));
    }
    function isMember(hid) {
      return request.auth != null && householdExists(hid)
        && request.auth.uid in household(hid).memberUids;
    }
    function isMemberOrGuest(hid) {
      return request.auth != null && householdExists(hid)
        && (request.auth.uid in household(hid).memberUids
            || request.auth.uid in household(hid).friendUids);
    }

    match /recipe-photos/{householdId}/{allPaths=**} {
      allow read: if isMemberOrGuest(householdId);
      // create/update carry a payload, so cap size (8 MB) and require an image;
      // delete has no payload, so it's checked on membership alone.
      allow create, update: if isMember(householdId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isMember(householdId);
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
