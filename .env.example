# Only needed by scripts/sync-recipes.ts, which pushes recipes/*.json into
# Firestore. Never bundled into the client.
#
# Firebase console › Project settings › Service accounts › Generate new
# private key. Save it OUTSIDE the repo, or in ./secrets/ which is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
FIREBASE_PROJECT_ID=your-project

# Saves passing --household= on every sync.
KITCHEN_HOUSEHOLD_ID=
