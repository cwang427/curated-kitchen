{
  "name": "curated-kitchen",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "ui": "vite -c vite.preview.config.ts",
    "ui:build": "vite build -c vite.preview.config.ts --outDir ../.preview-dist --emptyOutDir",
    "validate:recipes": "tsx scripts/validate-recipes.ts",
    "sync:recipes": "tsx scripts/sync-recipes.ts",
    "test:rules": "npx -y firebase-tools@13 emulators:exec --only firestore,auth --project curated-kitchen-rules-test 'tsx scripts/test-rules.ts'",
    "test:import": "tsx scripts/test-import.ts",
    "deploy:rules": "npx -y firebase-tools@13 deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-admin": "^13.0.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
